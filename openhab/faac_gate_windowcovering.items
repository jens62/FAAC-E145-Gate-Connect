//
// FAAC Gate - OpenHAB Items Configuration (WindowCovering variant)
// Using HomeKit WindowCovering instead of GarageDoorOpener
// NO RULES NEEDED - Direct MQTT position control!
//
// This variant uses WindowCovering which:
// - Works like rollershutters/blinds
// - No security prompts in HomeKit
// - Better for "Rolladen" style voice commands
// - Simpler HomeKit interface
//
// Server-side intelligent command mapping:
// - 0% / 100% → Mapped to "close"/"open" → Runs to limit switches
// - 1-99% → Position control → Accurate positioning
//

// Main Gate Control as Rollershutter with WindowCovering
// Position values are inverted at the MQTT channel level (see things file)
Rollershutter Hoftor "Hoftor [%d %%]" <rollershutter> (gGarage) ["WindowCovering"] {
    channel="mqtt:topic:mosquitto:faac_hoftor:position",
    ga="Rollershutter" [lang="de"],
    homekit="WindowCovering",
    alexa="Endpoint.Blind" [
        friendlyName="Hoftor",
        language="de"
    ]
}

// Wing 1 position for detailed monitoring
Number Hoftor_Wing1 "Hoftor Flügel 1 [%d %%]" <chart> (gGarage) {
    channel="mqtt:topic:mosquitto:faac_hoftor:wing1"
}

// Wing 2 position for detailed monitoring
Number Hoftor_Wing2 "Hoftor Flügel 2 [%d %%]" <chart> (gGarage) {
    channel="mqtt:topic:mosquitto:faac_hoftor:wing2"
}

// Gate state (OPEN, CLOSED, MOVING, STOPPED, UNKNOWN)
String Hoftor_State "Hoftor Status [%s]" <status> (gGarage) {
    channel="mqtt:topic:mosquitto:faac_hoftor:state"
}

// Gate availability (online/offline)
String Hoftor_Availability "Hoftor Verfügbarkeit [%s]" <network> (gGarage) {
    channel="mqtt:topic:mosquitto:faac_hoftor:availability"
}

// Server heartbeat - when did MQTT server last publish
DateTime Hoftor_ServerHeartbeat "Server Heartbeat [%1$td.%1$tm. %1$tH:%1$tM:%1$tS]" <time> (gGarage) {
    channel="mqtt:topic:mosquitto:faac_hoftor:server_heartbeat"
}

// Gate last seen - when did gate (USB) last respond
DateTime Hoftor_GateLastSeen "Tor zuletzt gesehen [%1$td.%1$tm. %1$tH:%1$tM:%1$tS]" <time> (gGarage) {
    channel="mqtt:topic:mosquitto:faac_hoftor:gate_last_seen"
}
