//
// FAAC Gate - OpenHAB Things Configuration
// MQTT connection and gate device (NO RULES NEEDED!)
//

Bridge mqtt:broker:mosquitto "MQTT Broker" [
    host="localhost",
    port=1883,
    secure=false,
    clientID="openhab_faac_gate"
    // username="your_username",
    // password="your_password"
] {

    // FAAC Gate Thing
    Thing topic faac_hoftor "Hoftor (FAAC)" @ "Hof" {
        Channels:
            // Rollershutter channel - handles everything!
            // UP/DOWN → 0%/100% → Server maps to "open"/"close" → Limit switches
            // STOP → "stop" → Immediate stop
            // Positions 1-99% → Position control → Accurate positioning
            // Automatically inverts values for OpenHAB convention
            Type rollershutter : position "Gate Position" [
                commandTopic="faac/gate/command",
                stateTopic="faac/gate/wing1",
                stop="stop",
                transformationPattern="JS:invert.js",
                transformationPatternOut="JS:invert.js",
                retained=false
            ]

            // State channel - current gate state
            Type string : state "Gate State" [
                stateTopic="faac/gate/state",
                retained=true
            ]

            // Wing 1 position - 0-100%
            Type number : wing1 "Wing 1 Position" [
                stateTopic="faac/gate/wing1",
                retained=true
            ]

            // Wing 2 position - 0-100%
            Type number : wing2 "Wing 2 Position" [
                stateTopic="faac/gate/wing2",
                retained=true
            ]

            // Availability - online/offline
            Type string : availability "Gate Availability" [
                stateTopic="faac/gate/availability",
                retained=true
            ]

            // Server heartbeat - when did server last publish (regardless of gate status)
            Type datetime : server_heartbeat "Server Heartbeat" [
                stateTopic="faac/gate/server_heartbeat",
                retained=true
            ]

            // Gate last seen - when did gate (USB) last respond with data
            Type datetime : gate_last_seen "Gate Last Seen" [
                stateTopic="faac/gate/gate_last_seen",
                retained=true
            ]
    }
}
