//
// FAAC Gate - OpenHAB Sitemap
// Visual interface for gate control with position display
//

sitemap faac_gate label="Hoftor Steuerung" {
    Frame label="Hoftor Kontrolle" {
        // Main rollershutter control - direct position control
        Switch item=Hoftor label="Hoftor" mappings=[UP="Öffnen", STOP="Stop", DOWN="Schließen"]

        // Position slider for precise control (0-100%)
        Slider item=Hoftor label="Position [%d %%]" minValue=0 maxValue=100 step=5

        // Current status
        Text item=Hoftor label="Aktuelle Position [%d %%]" icon="garagedoor"
    }

    Frame label="Detaillierte Ansicht" {
        // Individual wing positions
        Text item=Hoftor_Wing1 label="Flügel 1 (Master) [%d %%]" icon="chart"
        Slider item=Hoftor_Wing1 label="Flügel 1" minValue=0 maxValue=100 step=1 visibility=[Hoftor_State!="CLOSED"]

        Text item=Hoftor_Wing2 label="Flügel 2 (Slave) [%d %%]" icon="chart"
        Slider item=Hoftor_Wing2 label="Flügel 2" minValue=0 maxValue=100 step=1 visibility=[Hoftor_State!="CLOSED"]

        // Status with color coding
        Text item=Hoftor_State label="Status [%s]" icon="status" valuecolor=[
            Hoftor_State=="OPEN"="#4CAF50",
            Hoftor_State=="CLOSED"="#F44336",
            Hoftor_State=="MOVING"="#FFB300",
            Hoftor_State=="STOPPED"="#00BCD4",
            Hoftor_State=="UNKNOWN"="#757575"
        ]

        // Connection status
        Text item=Hoftor_Availability label="Verbindung [%s]" icon="network" valuecolor=[
            Hoftor_Availability=="online"="green",
            Hoftor_Availability=="offline"="red"
        ]
    }

    Frame label="Positionsverlauf" {
        Chart item=Hoftor_Wing1 label="Flügel 1 Verlauf" period=h refresh=30000 service="rrd4j"
        Chart item=Hoftor_Wing2 label="Flügel 2 Verlauf" period=h refresh=30000 service="rrd4j"
    }
}
